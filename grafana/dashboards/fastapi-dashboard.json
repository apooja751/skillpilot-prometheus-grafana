{
  "uid": "skillpilot-fastapi",
  "title": "SkillPilot FastAPI Monitoring",
  "tags": ["skillpilot", "fastapi", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total HTTP Requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(fastapi_requests_total)",
          "legendFormat": "Total requests",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request Rate (requests/sec)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(fastapi_requests_total[1m]))",
          "legendFormat": "Requests/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 5xx Error Rate (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "100 * sum(rate(fastapi_requests_total{http_status=~\"5..\"}[1m])) / clamp_min(sum(rate(fastapi_requests_total[1m])), 0.000001)",
          "legendFormat": "5xx errors (%)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Average Request Latency (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "expr": "sum(rate(fastapi_request_duration_seconds_sum[1m])) / clamp_min(sum(rate(fastapi_request_duration_seconds_count[1m])), 0.000001)",
          "legendFormat": "Average latency",
          "refId": "A"
        }
      ]
    }
  ]
}
